{
  "name": "remo-dance-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:dev": "mkdir -p .data/mongo && mongod --replSet rs0 --port 27018 --bind_ip 127.0.0.1 --dbpath .data/mongo --logpath .data/mongod.log --fork && sleep 2 && mongosh --quiet --port 27018 --eval \"try{rs.status().ok}catch(e){rs.initiate({_id:\\\"rs0\\\",members:[{_id:0,host:\\\"127.0.0.1:27018\\\"}]}).ok}\"",
    "db:stop": "mongosh --quiet --port 27018 --eval \"db.getSiblingDB(\\\"admin\\\").shutdownServer()\" || true",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "image-size": "^2.0.4",
    "lucide-react": "^1.66.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.4",
    "motion": "^14.9.0",
    "nanoid": "^5.1.16",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fast-check": "^4.10.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
