# ─── App ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Which academy this deployment serves (created by the seed script)
ACADEMY_SLUG=remo

# ─── Database ─────────────────────────────────────────────────────────
# Local: `npm run db:dev` starts a single-node replica set on port 27018 (transactions need one).
# Production: MongoDB Atlas, Mumbai (ap-south-1).
MONGODB_URI=mongodb://127.0.0.1:27018/remo?replicaSet=rs0

# ─── Auth (Better Auth) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
REQUIRE_EMAIL_VERIFICATION=false

# ─── Scheduled jobs ───────────────────────────────────────────────────
# Bearer token the external scheduler sends to /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Email (Resend) — optional in development: messages are logged instead
RESEND_API_KEY=
EMAIL_FROM="Remo Dance Company <hello@yourdomain.com>"

# ─── Media (Cloudinary) — optional in development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Maps & bot protection — optional
GOOGLE_MAPS_API_KEY=
TURNSTILE_SECRET_KEY=

# ─── Seed (demo data) ─────────────────────────────────────────────────
# The demo super admin is created from these values only; nothing is hard-coded.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Studio Owner"
# Optional: a demo parent account for trying the family portal locally (sign it up through /register).
SEED_GUARDIAN_EMAIL=demo.parent@remodance.example
SEED_GUARDIAN_PASSWORD=choose-a-long-password
# Required to seed anything other than a local database
SEED_ALLOW_REMOTE=false
